{:paths ["src" "resources"]
 
 :deps {org.clojure/clojure {:mvn/version "1.13.0-alpha6"}
        metosin/jsonista {:mvn/version "0.3.13"}
        io.resonatehq/resonate-sdk-java {:mvn/version "0.1.1"}}
 
 :aliases
 {:dev {:extra-paths ["dev"]
        :extra-deps {org.clojure/tools.namespace {:mvn/version "1.5.1"}}}
  
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
  
  :clj-kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
              :main-opts ["-m" "clj-kondo.main"]}

  :build {:deps {io.github.clojure/tools.build
                 {:git/tag "v0.9.2" :git/sha "fe6b140"}
                 slipset/deps-deploy {:mvn/version "0.2.0"}}
          :ns-default build}
  
  :neil {:project {:name resonate-clj/resonate-clj}}}}
 